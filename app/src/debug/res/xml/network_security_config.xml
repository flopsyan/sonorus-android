<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. A local Sonorus instance runs over plain HTTP, and
  10.0.2.2 is how the emulator reaches the host machine - so this is what makes
  it possible to drive the app against a test server.

  The release build ships no such file and therefore keeps Android's default:
  no cleartext at all. That matters here, because the session cookie carries the
  Secure flag and only travels over HTTPS anyway.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
